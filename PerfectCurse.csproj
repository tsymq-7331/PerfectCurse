<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Sts2Path>D:/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
    <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    <ModsPath>$(Sts2Path)/mods/</ModsPath>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PerfectCurseCode/**/*.cs" />
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.0" PrivateAssets="All" />
    <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" />
    <AdditionalFiles Include="PerfectCurse/localization/**/*.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="PerfectCurse/**" />
    <None Include="PerfectCurse.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="project.godot" />
    <None Include="PerfectCurse/**" />
  </ItemGroup>
  <Target Name="CopyBetaPackage" AfterTargets="PackPck" Condition="Exists('$(TargetPath)')">
    <PropertyGroup><BetaDir>$(MSBuildProjectDirectory)/dist/PerfectCurse</BetaDir></PropertyGroup>
    <MakeDir Directories="$(BetaDir)" />
    <Copy SourceFiles="$(TargetPath);PerfectCurse.json" DestinationFolder="$(BetaDir)" />
    <Copy SourceFiles="$(PckPackerOutputPath)" DestinationFolder="$(BetaDir)" Condition="Exists('$(PckPackerOutputPath)')" />
  </Target>
</Project>
